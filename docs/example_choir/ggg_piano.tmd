::SCORE::
** 幹幹幹 **
!= 120
?= C
~ "劉雪庵曲"
<2/4>

/* ========================================================================= */
/* 前奏 (Intro): 4 小節簡短號角感開場                                        */
/* ========================================================================= */

Intro:Piano@|0| {
    <4*>
    | 5_ (1 3)%(-) | 5 - | (1^ 6 5 3)%(--) | 5 - |
}

Intro:PianoLH@|0| {
    <4*>
    | [C] [C] | [C] [C] | [G7] [G7] | [C] - |
}

/* ========================================================================= */
/* 主段 (A): 17 小節主旋律與左手進行曲和弦伴奏                                */
/* ========================================================================= */

A:Piano@|0| {
    <4*>
    /* 幹幹幹！幹幹幹！大家努力幹 */
    | (5--5)%(-) 5 | (6--6)%(-) 6 | (1^--6)%(-) (1^--6)%(-) | (5--0)%(--) |
    /* 我們胸中有熱血 手裡有槍彈 要 */
    | (3--3)%(-) (3 3)%(-) | (5 6 5 3)%(--) | (2 1 2 3)%(--) | 1 (0 3)%(-) |
    /* 快要硬要切實 莫愁莫怕莫迂緩 */
    | (1 0 3 5 0 3)%(--) | 6 (5--3)%(-) | (50 0 6 1^ - - 6)%(--) | 2^ 1^ |
    /* 民眾作後援 自己當前面 */
    | (6 5 3 5)%(--) | (6 5 5 3)%(--) | (1^ 2^ 1^ 6)%(--) | 5 - |
    /* 轟轟烈烈幹一番 端的不負男兒願 */
    | (3 3 5 3)%(--) | (6 3)%(-) 5 | (1^ 6 5 1^)%(--) | 2^ 3^ | 1^ - |
}

A:PianoLH@|0| {
    <4*>
    /* 幹幹幹！幹幹幹！大家努力幹 */
    | [C] [C] | [Am] [Am] | [F] [F] | [C] - |
    /* 我們胸中有熱血 手裡有槍彈 要 */
    | [C] [C] | [C] [C] | [G7] [G7] | [C] [C] |
    /* 快要硬要切實 莫愁莫怕莫迂緩 */
    | [C] [C] | [F] [F] | [F] [F] | [G7] [G7] |
    /* 民眾作後援 自己當前面 */
    | [C] [C] | [C] [C] | [F] [F] | [C] [G7] |
    /* 轟轟烈烈幹一番 端的不負男兒願 */
    | [C] [C] | [Am] [Am] | [F] [G7] | [G7] [G7] | [C] - |
}

/* ========================================================================= */
/* 尾奏 (Outro): 4 小節簡短俐落結尾                                          */
/* ========================================================================= */

Outro:Piano@|0| {
    <4*>
    | (1^--6)%(-) (1^--6)%(-) | (5 3 2 3)%(--) | 1 1^ | 1^ - |
}

Outro:PianoLH@|0| {
    <4*>
    | [F] [F] | [G7] [G7] | [C] [C] | [C] - |
}

-> Intro
-> A
-> Outro
-> #
